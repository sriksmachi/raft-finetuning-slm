# Azure ML workspace (required by workflow scripts and notebooks)
AZURE_SUBSCRIPTION_ID=<<your Azure subscription id>>
AZURE_RESOURCE_GROUP=<<your resource group name>>
AZUREML_WORKSPACE_NAME=<<your Azure ML workspace name>>
AZURE_GPU_CLUSTER_NAME=<<your Azure ML GPU compute cluster name>>
AZURE_TRAIN_ENVIRONMENT_VERSION=1

# Azure OpenAI (only required for local synthetic data generation)
AZURE_OPENAI_ENDPOINT=<<your Azure OpenAI endpoint URL, e.g. https://your-resource-name.openai.azure.com/>>
AZURE_OPENAI_API_KEY=<<your Azure OpenAI API key>>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_GPT_DEPLOYMENT=<<your Azure OpenAI deployment name

AZURE_KEY_VAULT_NAME=<<your Azure Key Vault name>>
AZURE_KEY_VAULT_HF_TOKEN_SECRET_NAME=<<your Azure Key Vault secret name for Hugging Face token>>